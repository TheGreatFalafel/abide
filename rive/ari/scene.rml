                        <TransitionTriggerCondition inputId="0:209"/>
                    </StateTransition>
                    <StateTransition stateToId="0:230" duration="150">
                        <TransitionTriggerCondition inputId="0:210"/>
                    </StateTransition>
                </AnyState>
                <ExitState x="1100" y="-120" id="0:221"/>
                <EntryState x="0" y="80" id="0:222">
                    <StateTransition stateToId="0:230"/>
                </EntryState>

                <AnimationState x="160" y="80" animationId="0:300" id="0:230"/>
                <AnimationState x="360" y="0" animationId="0:301" reset="true" id="0:231">
                    <StateTransition stateToId="0:230" duration="180" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="360" y="80" animationId="0:302" id="0:232"/>
                <AnimationState x="360" y="160" animationId="0:303" id="0:233"/>
                <AnimationState x="560" y="0" animationId="0:304" reset="true" id="0:234">
                    <StateTransition stateToId="0:230" duration="150" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="560" y="80" animationId="0:305" id="0:235"/>
                <AnimationState x="560" y="160" animationId="0:306" id="0:236"/>
                <AnimationState x="760" y="0" animationId="0:307" reset="true" id="0:237">
                    <StateTransition stateToId="0:230" duration="150" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="760" y="80" animationId="0:308" reset="true" id="0:238">
