<Rive version="1" kind="fragment">
    <!--
      Ari — Storybook Warmth painterly lion (quadruped).
      Painted ImageAssets + Solo expression/pose swaps + root motion.
      Artboard: 520 x 400. State machine AriSM (product triggers unchanged).
    -->
    <ImageAsset file="assets/sit-idle.png" name="sitIdle" id="0:60"/>
    <ImageAsset file="assets/sit-happy.png" name="sitHappy" id="0:61"/>
    <ImageAsset file="assets/sit-think.png" name="sitThink" id="0:62"/>
    <ImageAsset file="assets/sit-curious.png" name="sitCurious" id="0:63"/>
    <ImageAsset file="assets/sit-gentle.png" name="sitGentle" id="0:64"/>
    <ImageAsset file="assets/walk.png" name="walkPose" id="0:65"/>

    <Artboard
        defaultStateMachineId="0:7"
        width="520"
        height="400"
        styleId="0:5"
        name="Ari"
        id="0:2"
    >
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <Fill name="Background">
            <SolidColor colorValue="00FFFFFF" name="Color"/>
        </Fill>

        <!-- Soft ground contact -->
        <Shape x="260" y="362" name="Shadow" id="0:10">
            <Ellipse originX="0.5" originY="0.5" width="260" height="28" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="2A1A3A34" name="Color"/>
            </Fill>
        </Shape>

        <!-- Root motion node (breathe / bounce / walk bob) -->
        <Node x="260" y="205" name="AriRoot" id="0:20">
            <Solo activeComponentId="0:71" name="PoseSolo" id="0:70">
                <Image
                    x="0"
                    y="0"
                    originX="0.5"
                    originY="0.55"
                    assetId="0:60"
                    name="Idle"
                    id="0:71"
