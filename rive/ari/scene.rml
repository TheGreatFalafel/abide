<Rive version="1" kind="fragment">
    <!--
      Ari — Gemini pose plates with long opacity ghost-fades + root breathe.
      No bone/mesh rig. Artboard Ari / state machine AriSM (product contract).
      Pose map:
        stand → idle, guide
        sit   → greet, encourage, correct (settled friendly)
        think → think
        walk  → walk, run (faster bob)
        sleep → sleep
        one-shots jump/celebrate/milestone → sit with hop, then exit to idle
    -->
    <ImageAsset file="assets/pose-stand.png" name="poseStand" id="0:60"/>
    <ImageAsset file="assets/pose-sit.png" name="poseSit" id="0:61"/>
    <ImageAsset file="assets/pose-think.png" name="poseThink" id="0:62"/>
    <ImageAsset file="assets/pose-walk.png" name="poseWalk" id="0:63"/>
    <ImageAsset file="assets/pose-sleep.png" name="poseSleep" id="0:64"/>

    <Artboard
        defaultStateMachineId="0:7"
        width="520"
        height="400"
        styleId="0:5"
        name="Ari"
        id="0:2"
    >
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <Fill name="Background">
            <SolidColor colorValue="00FFFFFF" name="Color"/>
        </Fill>

        <Node x="260" y="200" name="AriRoot" id="0:20">
            <Image x="0" y="0" originX="0.5" originY="0.5" assetId="0:60" opacity="1" name="Stand" id="0:21"/>
            <Image x="0" y="0" originX="0.5" originY="0.5" assetId="0:61" opacity="0" name="Sit" id="0:22"/>
            <Image x="0" y="0" originX="0.5" originY="0.5" assetId="0:63" opacity="0" name="Walk" id="0:23"/>
            <Image x="0" y="0" originX="0.5" originY="0.5" assetId="0:62" opacity="0" name="Think" id="0:24"/>
            <Image x="0" y="0" originX="0.5" originY="0.5" assetId="0:64" opacity="0" name="Sleep" id="0:25"/>
        </Node>

        <StateMachine name="AriSM" id="0:7">
            <StateMachineTrigger name="greet" id="0:200"/>
            <StateMachineTrigger name="walk" id="0:201"/>
            <StateMachineTrigger name="run" id="0:202"/>
            <StateMachineTrigger name="jump" id="0:203"/>
            <StateMachineTrigger name="think" id="0:204"/>
            <StateMachineTrigger name="guide" id="0:205"/>
            <StateMachineTrigger name="correct" id="0:206"/>
            <StateMachineTrigger name="encourage" id="0:207"/>
            <StateMachineTrigger name="celebrate" id="0:208"/>
            <StateMachineTrigger name="milestone" id="0:209"/>
            <StateMachineTrigger name="idle" id="0:210"/>
            <StateMachineTrigger name="sleep" id="0:211"/>

            <StateMachineLayer name="Main" id="0:8">
                <AnyState x="900" y="-120" id="0:220">
                    <StateTransition stateToId="0:231" duration="550">
                        <TransitionTriggerCondition inputId="0:200"/>
                    </StateTransition>
                    <StateTransition stateToId="0:232" duration="500">
                        <TransitionTriggerCondition inputId="0:201"/>
                    </StateTransition>
                    <StateTransition stateToId="0:233" duration="400">
                        <TransitionTriggerCondition inputId="0:202"/>
                    </StateTransition>
                    <StateTransition stateToId="0:234" duration="350">
                        <TransitionTriggerCondition inputId="0:203"/>
                    </StateTransition>
                    <StateTransition stateToId="0:235" duration="550">
                        <TransitionTriggerCondition inputId="0:204"/>
                    </StateTransition>
                    <StateTransition stateToId="0:236" duration="500">
                        <TransitionTriggerCondition inputId="0:205"/>
                    </StateTransition>
                    <StateTransition stateToId="0:237" duration="450">
                        <TransitionTriggerCondition inputId="0:206"/>
                    </StateTransition>
                    <StateTransition stateToId="0:238" duration="500">
                        <TransitionTriggerCondition inputId="0:207"/>
                    </StateTransition>
                    <StateTransition stateToId="0:239" duration="450">
                        <TransitionTriggerCondition inputId="0:208"/>
                    </StateTransition>
                    <StateTransition stateToId="0:240" duration="450">
                        <TransitionTriggerCondition inputId="0:209"/>
                    </StateTransition>
                    <StateTransition stateToId="0:230" duration="600">
                        <TransitionTriggerCondition inputId="0:210"/>
                    </StateTransition>
                    <StateTransition stateToId="0:241" duration="700">
