                </EntryState>

                <AnimationState x="160" y="80" animationId="0:300" id="0:230"/>
                <AnimationState x="360" y="0" animationId="0:301" reset="true" id="0:231">
                    <StateTransition stateToId="0:230" duration="500" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="360" y="80" animationId="0:302" id="0:232"/>
                <AnimationState x="360" y="160" animationId="0:303" id="0:233"/>
                <AnimationState x="560" y="0" animationId="0:304" reset="true" id="0:234">
