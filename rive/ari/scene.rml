        <!-- Idle: sit, breathe, blink, soft tail, warm smile -->
        <LinearAnimation loopValue="loop" duration="180" name="idle" id="0:300">
            <KeyedObject objectId="0:50">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" interpolationType="cubic"/>
                    <KeyFrameDouble value="1.03" interpolationType="cubic" frame="90"/>
                    <KeyFrameDouble value="1" interpolationType="cubic" frame="180"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:90">
