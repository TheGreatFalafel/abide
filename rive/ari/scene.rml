            </Solo>
        </Node>

        <!-- ===== State machine (same trigger names as product) ===== -->
        <StateMachine name="AriSM" id="0:7">
            <StateMachineTrigger name="greet" id="0:200"/>
            <StateMachineTrigger name="walk" id="0:201"/>
            <StateMachineTrigger name="run" id="0:202"/>
            <StateMachineTrigger name="jump" id="0:203"/>
            <StateMachineTrigger name="think" id="0:204"/>
            <StateMachineTrigger name="guide" id="0:205"/>
            <StateMachineTrigger name="correct" id="0:206"/>
            <StateMachineTrigger name="encourage" id="0:207"/>
            <StateMachineTrigger name="celebrate" id="0:208"/>
            <StateMachineTrigger name="milestone" id="0:209"/>
            <StateMachineTrigger name="idle" id="0:210"/>

            <StateMachineLayer name="Main" id="0:8">
                <AnyState x="900" y="-120" id="0:220">
                    <StateTransition stateToId="0:231" duration="120">
                        <TransitionTriggerCondition inputId="0:200"/>
                    </StateTransition>
                    <StateTransition stateToId="0:232" duration="120">
                        <TransitionTriggerCondition inputId="0:201"/>
                    </StateTransition>
                    <StateTransition stateToId="0:233" duration="100">
                        <TransitionTriggerCondition inputId="0:202"/>
                    </StateTransition>
                    <StateTransition stateToId="0:234" duration="100">
                        <TransitionTriggerCondition inputId="0:203"/>
                    </StateTransition>
                    <StateTransition stateToId="0:235" duration="150">
                        <TransitionTriggerCondition inputId="0:204"/>
                    </StateTransition>
