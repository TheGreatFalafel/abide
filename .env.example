# Abide — local + Vercel cloud (Phase 2)
# Copy to `.env.local` and fill in. Never commit secrets.

# --- Neon Postgres (free, separate from Supabase) ---
# Create at https://console.neon.tech → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Clerk auth (free) ---
# Create at https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: ESV key can stay in the browser (Settings). No server env needed.
